<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@drawable/bg_jumper_menu"
    android:padding="28dp">

    <!-- Карточка результата -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/resultCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/item_bg"
        android:padding="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/resultTitleTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="Game Over!"
            android:layout_marginTop="15dp"
            android:textColor="@color/white"
            android:fontFamily="@font/bebas"
            android:textSize="34sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/resultScoreTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="Score: 0"
            android:textColor="@color/white"
            android:textSize="22sp"

            android:fontFamily="@font/bebas"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/resultTitleTextView"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/resultHeightTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            tools:text="Height: 0 m"
            android:textColor="@color/white"
            android:fontFamily="@font/bebas"
            android:textSize="17sp"
            app:layout_constraintTop_toBottomOf="@id/resultScoreTextView"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/rewardTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_coin_panel"
            android:paddingStart="18dp"
            android:paddingTop="8dp"
            android:fontFamily="@font/bebas"
            android:paddingEnd="18dp"
            android:paddingBottom="8dp"
            tools:text="Reward: +0 coins"
            android:textColor="@color/jumper_text_primary"
            android:textSize="17sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/resultHeightTextView"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <ImageView
            android:id="@+id/nextButton"
            android:layout_width="75dp"
            android:layout_height="75dp"
            android:layout_marginTop="26dp"
            android:background="@drawable/bg_small_button"
            android:src="@drawable/ic_arrow_next"
            android:padding="17dp"
            app:layout_constraintTop_toBottomOf="@id/rewardTextView"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintHorizontal_chainStyle="packed" />

        <ImageView
            android:id="@+id/restartButton"
            android:layout_width="75dp"
            android:layout_height="75dp"
            android:layout_marginTop="26dp"
            android:background="@drawable/bg_small_button"
            android:src="@drawable/ic_restart"
            android:padding="17dp"
            app:layout_constraintTop_toBottomOf="@id/rewardTextView"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintHorizontal_chainStyle="packed"  />

        <ImageView
            android:id="@+id/menuButton"
            android:layout_width="75dp"
            android:layout_height="75dp"
            android:layout_marginTop="26dp"
            android:layout_marginStart="16dp"
            android:background="@drawable/bg_small_button"
            android:src="@drawable/ic_home"
            android:padding="17dp"
            app:layout_constraintTop_toBottomOf="@id/rewardTextView"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>