<?xml version="1.0" encoding="utf-8"?>
<!--
    Data extraction rules (Android 12+).
    Applies to both cloud backup and device-to-device transfer.
    Only the local game database is backed up.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="mini_game_starter.db" />
        <include domain="database" path="mini_game_starter.db-wal" />
        <include domain="database" path="mini_game_starter.db-shm" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="mini_game_starter.db" />
        <include domain="database" path="mini_game_starter.db-wal" />
        <include domain="database" path="mini_game_starter.db-shm" />
    </device-transfer>
</data-extraction-rules>
